%% Activity Diagram: Patient Appointment Management
%% Based on src/app/account/page.tsx implementation
%% Covers: View appointments, Cancel appointment, Reschedule appointment

flowchart TD
    Start([Start]) --> A[Login to Client Portal /account]
    A --> B[claim_my_patient_record RPC]
    B --> C[Load Patient Data & Appointments]
    C --> D[View Upcoming & History Tabs]
    
    D --> E{Select Action}
    
    E -->|View Appointment| F[Display Appointment Details]
    F --> D
    
    E -->|Cancel Appointment| G[Open Branded Confirmation Dialog]
    G --> H{Confirm Cancel?}
    
    H -->|Keep Visit| I[Close Dialog]
    I --> D
    
    H -->|Cancel Visit| J[Call RPC cancel_my_appointment]
    J --> K{Cancellation Success?}
    K -->|Error not_cancellable| L[Show Error: Cannot Cancel Online]
    L --> D
    
    K -->|Other Error| M[Show Error: Contact Clinic]
    M --> D
    
    K -->|Success| N[Update Appointment Status to cancelled]
    N --> O[Show Success Toast]
    O --> D
    
    E -->|Reschedule Appointment| P[Open Reschedule Interface]
    P --> Q[Select New Date]
    Q --> R[Fetch Booked Slots via RPC get_booked_slots]
    R --> S[Select New Time Slot]
    S --> T[Call RPC reschedule_my_appointment]
    T --> U{Reschedule Success?}
    U -->|Error slot_taken| V[Show Error: Slot Taken]
    V --> S
    
    U -->|Other Error| W[Show Error: Try Again]
    W --> S
    
    U -->|Success| X[Update Appointment scheduled_at]
    X --> Y[Show Success Toast]
    Y --> D

    style Start fill:#e1f5e1,stroke:#008000,stroke-width:2px
    style AC fill:#ffcccc,stroke:#cc0000,stroke-width:2px