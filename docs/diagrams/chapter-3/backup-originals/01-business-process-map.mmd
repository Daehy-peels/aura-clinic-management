flowchart TD
    %% Business Process Map - Aura Aesthetic Clinic
    %% Actors: Guest, Patient, Staff

    subgraph Guest_Processes [Guest Processes]
        G1[Browse Treatments & Services]
        G2[Book Appointment - Guest Booking]
        G3[Register New Account]
    end

    subgraph Patient_Processes [Patient Processes]
        P1[Login to Client Portal]
        P2[Claim Patient Record]
        P3[View Appointments Upcoming & History]
        P4[Cancel Appointment]
        P5[Reschedule Appointment]
        P6[Update Profile & Medical Details]
    end

    subgraph Staff_Processes [Staff Processes]
        S1[Login to Staff Dashboard]
        S2[View Dashboard Statistics]
        S3[Manage Patient Directory Create Read Update Delete]
        S4[Schedule Appointment for Patient]
        S5[Update Appointment Status & Details]
        S6[Delete Appointment]
    end

    %% Guest flow
    G1 --> G2
    G2 --> G3

    %% Patient flow
    G3 --> P1
    P1 --> P2
    P2 --> P3
    P3 --> P4
    P3 --> P5
    P3 --> P6

    %% Staff flow
    S1 --> S2
    S2 --> S3
    S3 --> S4
    S4 --> S5
    S5 --> S6

    %% Cross-actor connections
    G2 -.->|Creates patient record| S3
    P4 -.->|Updates appointment status| S5
    P5 -.->|Updates appointment time| S5

    style Guest_Processes fill:#f9f,stroke:#333,stroke-width:2px
    style Patient_Processes fill:#bfb,stroke:#333,stroke-width:2px
    style Staff_Processes fill:#bbf,stroke:#333,stroke-width:2px